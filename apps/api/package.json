{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "REST API (Fastify) and workers",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.js",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "openapi:export": "tsx src/scripts/export-openapi.ts ../../packages/shared/openapi.json",
    "osm:import": "tsx src/scripts/import-osm.ts",
    "check:family-limit": "tsx src/scripts/check-family-limit.ts",
    "build": "tsc --noEmit",
    "build:server": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@pet-app/db-testing": "workspace:*",
    "@types/node": "^22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1172.0",
    "@aws-sdk/s3-request-presigner": "3.1172.0",
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.4",
    "@pet-app/db": "workspace:*",
    "@pet-app/shared": "workspace:*",
    "@sentry/node": "11.13.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.17",
    "zod": "4.6.7"
  }
}
