{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "REST API (Fastify) and workers",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "openapi:export": "tsx src/scripts/export-openapi.ts ../../packages/shared/openapi.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.4",
    "@pet-app/db": "workspace:*",
    "@pet-app/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.17",
    "zod": "4.6.7"
  }
}
