    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.petapp.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "app.petapp.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      "expo-secure-store",
