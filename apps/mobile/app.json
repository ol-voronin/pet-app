{
  "expo": {
    "name": "Pet App",
    "slug": "pet-app",
    "scheme": "petapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.petapp.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "app.petapp.mobile"
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-localization"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
