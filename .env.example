# Copy to .env and fill in. Never commit real values.

# Neon Postgres: project "pet-app" (green-wind-84602753), branch "dev", database "petapp".
# Use the pooled connection string from the Neon console. Only `pnpm -F db migrate` needs it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/petapp?sslmode=require

# API auth: HMAC key for access tokens, OTP and refresh-token hashes (>= 32 chars). Generate: openssl rand -hex 32
JWT_SECRET=

# Dev only: every OTP equals this code, so you can log in without SMS. Forbidden in production.
OTP_FIXED_CODE=000000
