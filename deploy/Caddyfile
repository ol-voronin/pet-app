# HTTPS for the API. The certificate is issued and renewed automatically (Let's Encrypt)
# once API_DOMAIN points at this server and ports 80 and 443 are open.
{$API_DOMAIN} {
	encode zstd gzip


	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	# Admin panel (Directus), when it is switched on; otherwise this path answers 502.
	handle_path /cms/* {
		reverse_proxy directus:8055
	}

	handle {
		# The API takes JSON only; files go straight to object storage by signed URL.
		request_body {
			max_size 1MB
		}
		reverse_proxy api:3000
	}
}
