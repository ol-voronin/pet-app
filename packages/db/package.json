{
  "name": "@pet-app/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema and migrations",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1",
    "drizzle-orm": "0.45.4"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ]
}
