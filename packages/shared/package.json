{
  "name": "@pet-app/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared zod schemas, types and generated API client",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "generate": "openapi-typescript openapi.json -o src/api/openapi.ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "zod": "4.6.7"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  }
}
