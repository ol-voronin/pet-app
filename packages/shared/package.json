{
  "name": "@pet-app/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared zod schemas, types and generated API client",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "generate": "openapi-typescript openapi.json -o src/api/openapi.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "date-fns": "4.4.0",
    "openapi-fetch": "0.17.0",
    "zod": "4.6.7"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ]
}
